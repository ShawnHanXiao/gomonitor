<Window x:Class="GoMonitor.Views.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GoMonitor"
        Width="344"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Deactivated="OnDeactivated"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="PanelButton" TargetType="Button">
            <Setter Property="Background" Value="#21262D" />
            <Setter Property="Foreground" Value="#E6EDF3" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#30363D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1F242C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#161B22"
            BorderBrush="#30363D"
            BorderThickness="1"
            CornerRadius="8">
        <Grid Margin="16,14,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot"
                             Width="10"
                             Height="10"
                             Fill="#8B949E"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0" />
                    <TextBlock Text="GO USAGE"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#E6EDF3" />
                </StackPanel>
                <TextBlock x:Name="UpdatedText"
                           Grid.Column="1"
                           Text="Updated --:--:--"
                           FontSize="11"
                           FontFamily="Consolas"
                           Foreground="#8B949E"
                           VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,12,0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="54" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="5h"
                               FontSize="12"
                               FontFamily="Consolas"
                               Foreground="#8B949E"
                               VerticalAlignment="Center" />
                    <ProgressBar x:Name="RollingBar"
                                 Grid.Column="1"
                                 Height="6"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Background="#21262D"
                                 Foreground="#3FB950"
                                 BorderThickness="0"
                                 VerticalAlignment="Center" />
                    <TextBlock x:Name="RollingPercent"
                               Grid.Column="2"
                               Text="--"
                               FontSize="12"
                               FontFamily="Consolas"
                               Foreground="#E6EDF3"
                               TextAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>

                <Border Grid.Row="1" Background="#21262D" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="54" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Week"
                               FontSize="12"
                               FontFamily="Consolas"
                               Foreground="#8B949E"
                               VerticalAlignment="Center" />
                    <ProgressBar x:Name="WeeklyBar"
                                 Grid.Column="1"
                                 Height="6"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Background="#21262D"
                                 Foreground="#E3B341"
                                 BorderThickness="0"
                                 VerticalAlignment="Center" />
                    <TextBlock x:Name="WeeklyPercent"
                               Grid.Column="2"
                               Text="--"
                               FontSize="12"
                               FontFamily="Consolas"
                               Foreground="#E6EDF3"
                               TextAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>

                <Border Grid.Row="3" Background="#21262D" />

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="54" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Month"
                               FontSize="12"
                               FontFamily="Consolas"
                               Foreground="#8B949E"
                               VerticalAlignment="Center" />
                    <ProgressBar x:Name="MonthlyBar"
                                 Grid.Column="1"
                                 Height="6"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Background="#21262D"
                                 Foreground="#F0883E"
                                 BorderThickness="0"
                                 VerticalAlignment="Center" />
                    <TextBlock x:Name="MonthlyPercent"
                               Grid.Column="2"
                               Text="--"
                               FontSize="12"
                               FontFamily="Consolas"
                               Foreground="#E6EDF3"
                               TextAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <TextBlock x:Name="ResetsText"
                       Grid.Row="2"
                       Margin="0,6,0,0"
                       Text="Resets - 5h -- | Week -- | Month --"
                       FontSize="11"
                       FontFamily="Consolas"
                       Foreground="#8B949E" />

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        Margin="0,10,0,0">
                <Button Style="{StaticResource PanelButton}"
                        Click="OnRefreshClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PanelButton}"
                        Margin="8,0,0,0"
                        Click="OnOpenConsoleClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Open Console" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PanelButton}"
                        Margin="8,0,0,0"
                        Click="OnSettingsClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Settings" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border x:Name="ErrorPanel"
                    Grid.Row="4"
                    Margin="0,10,0,0"
                    Background="#3D1418"
                    BorderBrush="#DA3633"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,6"
                    Visibility="Collapsed">
                <TextBlock x:Name="ErrorText"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="#F85149" />
            </Border>
        </Grid>
    </Border>
</Window>
